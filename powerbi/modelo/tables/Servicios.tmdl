table Servicios
	column serviceCode
		dataType: String
		summarizeBy: none
		sourceColumn: serviceCode

	column requests
		dataType: Int64
		summarizeBy: none
		sourceColumn: requests

	column successfulRequests
		dataType: Int64
		summarizeBy: none
		sourceColumn: successfulRequests

	column blockedRequests
		dataType: Int64
		summarizeBy: none
		sourceColumn: blockedRequests

	column errorRequests
		dataType: Int64
		summarizeBy: none
		sourceColumn: errorRequests

	column promptTokens
		dataType: Int64
		summarizeBy: none
		sourceColumn: promptTokens

	column completionTokens
		dataType: Int64
		summarizeBy: none
		sourceColumn: completionTokens

	column totalTokens
		dataType: Int64
		summarizeBy: none
		sourceColumn: totalTokens

	column averageTokens
		dataType: Int64
		summarizeBy: none
		sourceColumn: averageTokens

	column averageLatencyMs
		dataType: Int64
		summarizeBy: none
		sourceColumn: averageLatencyMs

	column activeUsers
		dataType: Int64
		summarizeBy: none
		sourceColumn: activeUsers

	column sharePercent
		dataType: Double
		summarizeBy: none
		sourceColumn: sharePercent
	partition Servicios-Partition = m
		mode: import
		source =
			let
			    url = "https://rutaia-api-q3y2.onrender.com/api/bi/usage?from=2026-01-01&to=2026-12-31",
			    respuesta = Web.Contents(url, [Headers = [#"X-API-Key" = ApiKey]]),
			    registros = Json.Document(respuesta)[byService],
			    tabla = Table.FromRecords(registros)
			in
			    tabla