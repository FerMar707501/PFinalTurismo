table Mensual
	column month
		dataType: String
		summarizeBy: none
		sourceColumn: month

	column requests
		dataType: Int64
		summarizeBy: none
		sourceColumn: requests

	column successfulRequests
		dataType: Int64
		summarizeBy: none
		sourceColumn: successfulRequests

	column blockedRequests
		dataType: Int64
		summarizeBy: none
		sourceColumn: blockedRequests

	column totalTokens
		dataType: Int64
		summarizeBy: none
		sourceColumn: totalTokens

	column promptTokens
		dataType: Int64
		summarizeBy: none
		sourceColumn: promptTokens

	column completionTokens
		dataType: Int64
		summarizeBy: none
		sourceColumn: completionTokens
	partition Mensual-Partition = m
		mode: import
		source =
			let
			    url = "https://rutaia-api-q3y2.onrender.com/api/bi/usage?from=2026-01-01&to=2026-12-31",
			    respuesta = Web.Contents(url, [Headers = [#"X-API-Key" = ApiKey]]),
			    registros = Json.Document(respuesta)[monthly],
			    tabla = Table.FromRecords(registros)
			in
			    tabla