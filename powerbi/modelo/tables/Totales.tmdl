table Totales
	column requests
		dataType: Int64
		summarizeBy: none
		sourceColumn: requests

	column successfulRequests
		dataType: Int64
		summarizeBy: none
		sourceColumn: successfulRequests

	column blockedRequests
		dataType: Int64
		summarizeBy: none
		sourceColumn: blockedRequests

	column errorRequests
		dataType: Int64
		summarizeBy: none
		sourceColumn: errorRequests

	column promptTokens
		dataType: Int64
		summarizeBy: none
		sourceColumn: promptTokens

	column completionTokens
		dataType: Int64
		summarizeBy: none
		sourceColumn: completionTokens

	column totalTokens
		dataType: Int64
		summarizeBy: none
		sourceColumn: totalTokens

	column averageTokens
		dataType: Int64
		summarizeBy: none
		sourceColumn: averageTokens

	column averageLatencyMs
		dataType: Int64
		summarizeBy: none
		sourceColumn: averageLatencyMs

	column activeUsers
		dataType: Int64
		summarizeBy: none
		sourceColumn: activeUsers

	column successRate
		dataType: Double
		summarizeBy: none
		sourceColumn: successRate
	measure 'Total de tokens' = SUM(Totales[totalTokens])
		formatString: #,##0

	measure 'Solicitudes' = SUM(Totales[requests])
		formatString: #,##0

	measure 'Tasa de éxito' = DIVIDE(SUM(Totales[successfulRequests]), SUM(Totales[requests]))
		formatString: 0.00%

	measure 'Latencia media' = AVERAGE(Totales[averageLatencyMs])
		formatString: #,##0

	measure 'Promedio diario de tokens' = DIVIDE(SUM(Totales[totalTokens]), COUNTROWS(Diario))
		formatString: #,##0
	partition Totales-Partition = m
		mode: import
		source =
			let
			    url = "https://rutaia-api-q3y2.onrender.com/api/bi/usage?from=2026-01-01&to=2026-12-31",
			    respuesta = Web.Contents(url, [Headers = [#"X-API-Key" = ApiKey]]),
			    totales = Json.Document(respuesta)[totals],
			    tabla = #table(Record.FieldNames(totales), {Record.FieldValues(totales)})
			in
			    tabla