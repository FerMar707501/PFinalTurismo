# ============================================================
# API RutaIA — copia este archivo como server/.env
# ============================================================

NODE_ENV=development
PORT=4000

# Base de datos (Docker Compose local)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=rutaia
DB_PASSWORD=rutaia_local_dev
DB_NAME=rutaia
DB_CONNECTION_LIMIT=10

# Autenticación
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
JWT_EXPIRES_IN=1h

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_LITE=openai/gpt-oss-20b
GROQ_MAX_TOKENS=1024
GROQ_TEMPERATURE=0.2

# CORS: origen del frontend
CORS_ORIGIN=http://localhost:5173

# Cuota mensual inicial para nuevos usuarios (tokens)
TOKEN_QUOTA_DEFAULT=50000
